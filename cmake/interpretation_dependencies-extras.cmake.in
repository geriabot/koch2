# Interpretation, opt-in (interpretation-extras.cmake): the packages that its targets link.
#
# Included after the package's other config files, once the default variables
# (koch2_LIBRARIES, _INCLUDE_DIRS, ...) are computed, so that they are not
# changed. A missing dependency does not fail the package, whose base does not need it: it
# only sets koch2_INTERPRETATION_FOUND to FALSE.

set(_koch2_interpretation_dependencies "@_interpretation_export_dependencies@")

set(koch2_INTERPRETATION_FOUND TRUE)
foreach(_dep ${_koch2_interpretation_dependencies})
  if(NOT ${_dep}_FOUND)
    find_package(${_dep} QUIET)
  endif()
  if(NOT ${_dep}_FOUND)
    set(koch2_INTERPRETATION_FOUND FALSE)
  endif()
endforeach()

if(NOT koch2_INTERPRETATION_FOUND AND NOT koch2_FIND_QUIETLY)
  message(STATUS "koch2: a dependency of interpretation was not found: "
    "koch2::interpretation cannot be linked")
endif()

unset(_koch2_interpretation_dependencies)
